# ===========================================================================
#  Copia este archivo como ".env" y cambialo a tu gusto.
#
#      copy .env.example .env      (en Windows)
#      cp .env.example .env        (en Linux/Mac)
#
#  El archivo ".env" esta en el .gitignore: no se sube al repositorio.
#  Por eso aqui SOLO hay valores de ejemplo, nunca contrasenas reales.
# ===========================================================================

# --- Datos del servicio ----------------------------------------------------
NOMBRE_SERVICIO=kds-security-service
# Keycloak ya usa el 8080, asi que este servicio usa el 5000.
PUERTO=5000
LOG_LEVEL=INFO

# Rutas que NO piden token. Sirven para que Docker y los monitores
# comprueben que el servicio vive sin necesitar credenciales.
RUTAS_SIN_AUTENTICAR=/,/health

# Registrar un evento en Kafka por CADA peticion con token valido.
# Da mucha mas informacion, pero tambien mucho mas trafico: con `false`
# solo se guardan los rechazos, que son los que de verdad interesa.
PUBLICAR_ACCESOS_PERMITIDOS=true

# --- Keycloak --------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=kds
KEYCLOAK_CLIENT_ID=kds-api

# AUDIENCIA del token. Si la dejas vacia, no se comprueba el campo `aud`.
# Para uso basico esta bien vacia. En produccion conviene ponerla
# (por ejemplo: "kds-api") para que un token de otra aplicacion no valga.
KEYCLOAK_AUDIENCE=

# Poner en `false` permite trabajar en local sin levantar Keycloak.
# NUNCA lo pongas en `false` en un entorno real.
AUTH_HABILITADO=true

# Segundos que se espera a Keycloak al bajar las llaves publicas.
KEYCLOAK_SEGUNDOS_ESPERA_JWKS=5

# --- Kafka -----------------------------------------------------------------
# Uno o varios brokers separados por coma.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=kds-security-service

# Poner en `false` apaga la publicacion de eventos (el servicio sigue
# funcionando, solo deja de registrar). Util para depurar sin Kafka.
KAFKA_HABILITADO=true

# Cuanto esperamos a Kafka antes de seguir con nuestra vida.
KAFKA_SEGUNDOS_ESPERA=5
