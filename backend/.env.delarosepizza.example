# Backend de la empresa delarosepizza (copiar a .env.delarosepizza). Se arranca con:  node --env-file=.env.delarosepizza dist/server.js
TENANT_ID=delarosepizza
PORT=3002
DATABASE_URL=postgresql://kds:kds@localhost:5433/kds_delarosepizza
CORS_ORIGINS=http://localhost:4400
# Keycloak local (docker compose up -d en la raíz del repo). Vacío = API sin autenticación.
AUTH_ISSUER=http://localhost:8081/realms/kds-delarosepizza
AUTH_CLIENT_ID=kds-frontend
