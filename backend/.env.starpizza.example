# Backend de la empresa starpizza (copiar a .env.starpizza). Se arranca con:  node --env-file=.env.starpizza dist/server.js
TENANT_ID=starpizza
PORT=3001
DATABASE_URL=postgresql://kds:kds@localhost:5433/kds_starpizza
CORS_ORIGINS=http://localhost:4300
# Keycloak local (docker compose up -d en la raíz del repo). Vacío = API sin autenticación.
AUTH_ISSUER=http://localhost:8081/realms/kds-starpizza
AUTH_CLIENT_ID=kds-frontend
